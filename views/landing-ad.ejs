<!DOCTYPE html>
<html lang="en" class="h-full bg-white antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  
  <title><%= (typeof seo !== 'undefined' && seo.title) ? seo.title : 'NEXO Digital Business Card — ₹299 Lifetime Access' %></title>
  <meta name="description" content="<%= (typeof seo !== 'undefined' && seo.description) ? seo.description : 'Create your professional NEXO Digital Business Card for ₹299. Share contact details, QR code, and clickable PDF.' %>" />
  <link rel="canonical" href="<%= (typeof seo !== 'undefined' && seo.canonicalUrl) ? seo.canonicalUrl : 'https://nexocard.in/offer' %>" />

  <!-- Open Graph / Facebook / Instagram -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="NEXO Digital Business Card — ₹299 Lifetime Access" />
  <meta property="og:description" content="Still carrying a paper visiting card? Go digital with NEXO for ₹299 (One-Time Payment • Lifetime Access)." />
  <meta property="og:url" content="https://nexocard.in/offer" />

  <!-- Fonts & Tailwind CSS CDN -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    /* --------------------------------------------------------------------------
       MOBILE-FIRST CONVERSION ENGINE STYLES
       -------------------------------------------------------------------------- */
    :root {
      --navy-main: #0A1128;
      --navy-dark: #050814;
      --nexo-purple: #4F46E5;
      --nexo-accent: #06B6D4;
      --price-green: #10B981;
      --bg-light: #F8FAFC;
      --font-poppins: 'Poppins', -apple-system, sans-serif;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      touch-action: manipulation;
    }

    html {
      scroll-behavior: smooth;
      text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }

    html, body {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden !important;
      position: relative;
      font-family: var(--font-poppins);
      background-color: #FFFFFF;
      color: #0F172A;
    }

    /* Padding offset to prevent sticky CTA covering footer content */
    body {
      padding-bottom: 84px;
    }

    /* High-contrast dominant primary CTAs */
    .btn-cta-primary {
      background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
      color: #FFFFFF;
      font-weight: 800;
      font-size: 16px;
      padding: 16px 24px;
      border-radius: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.4);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      width: 100%;
      text-align: center;
      border: none;
      cursor: pointer;
    }

    .btn-cta-primary:active {
      transform: scale(0.98);
    }

    .btn-sticky-bar {
      background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
      color: #FFFFFF;
      font-weight: 800;
      font-size: 14px;
      padding: 12px 18px;
      border-radius: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-decoration: none;
      box-shadow: 0 4px 15px rgba(79, 70, 229, 0.35);
      width: 100%;
    }

    /* Phone Mockup Styling */
    .mockup-container {
      width: 100%;
      max-width: 320px;
      height: 570px;
      background: #000000;
      border-radius: 38px;
      padding: 8px;
      box-shadow: 0 25px 50px -12px rgba(10, 17, 40, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.15);
      margin: 0 auto;
    }

    .mockup-screen {
      width: 100%;
      height: 100%;
      background: #F8FAF9;
      border-radius: 30px;
      overflow-y: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .mockup-screen::-webkit-scrollbar {
      display: none;
    }

    /* FAQ Accordion */
    .faq-item {
      border: 1px solid #E2E8F0;
      border-radius: 16px;
      overflow: hidden;
      background: #FFFFFF;
      transition: border-color 0.2s ease;
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s cubic-bezier(0, 1, 0, 1), padding 0.3s ease;
    }

    .faq-item.open .faq-answer {
      max-height: 300px;
      padding-bottom: 16px;
    }

    .faq-item.open .faq-icon {
      transform: rotate(180deg);
    }
  </style>
</head>
<body class="bg-white text-slate-900 antialiased">

