  <!-- JavaScript for Interactive Accordion and Conversion Tracking -->
  <script>
    // FAQ Accordion Handler
    document.querySelectorAll('.faq-item button').forEach(button => {
      button.addEventListener('click', () => {
        const item = button.parentElement;
        const isOpen = item.classList.contains('open');
        
        document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
        
        if (!isOpen) {
          item.classList.add('open');
        }
      });
    });

    // Conversion Analytics Hooks
    const ctaIds = ['hero-cta', 'price-cta', 'final-cta', 'create-nexo-card'];
    ctaIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('click', () => {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'click_landing_cta', {
              event_category: 'conversion',
              event_label: id,
              value: 299
            });
          }
          if (typeof window.fbq === 'function') {
            window.fbq('track', 'InitiateCheckout', { value: 299, currency: 'INR' });
          }
        });
      }
    });
  </script>

