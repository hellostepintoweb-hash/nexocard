          <!-- Key Value Checkmarks -->
          <div class="grid grid-cols-2 gap-2 text-[12px] font-semibold text-slate-700 pt-1 mb-8 md:mb-0">
            <div class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Digital Card</div>
            <div class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> QR Code</div>
            <div class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Clickable PDF</div>
            <div class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> WhatsApp Sharing</div>
