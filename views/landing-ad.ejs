<!DOCTYPE html>
<html lang="en" class="h-full bg-white antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  
  <title><%= (typeof seo !== 'undefined' && seo.title) ? seo.title : 'NEXO Digital Business Card — ₹299 Lifetime Access' %></title>
  <meta name="description" content="<%= (typeof seo !== 'undefined' && seo.description) ? seo.description : 'Create your professional NEXO Digital Business Card for ₹299. Share contact details, QR code, and clickable PDF.' %>" />
  <link rel="canonical" href="<%= (typeof seo !== 'undefined' && seo.canonicalUrl) ? seo.canonicalUrl : 'https://nexocard.in/offer' %>" />

  <!-- Open Graph / Facebook / Instagram -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="NEXO Digital Business Card — ₹299 Lifetime Access" />
  <meta property="og:description" content="Still carrying a paper visiting card? Go digital with NEXO for ₹299 (One-Time Payment • Lifetime Access)." />
  <meta property="og:url" content="https://nexocard.in/offer" />

  <!-- Fonts & Frameworks -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    /* --------------------------------------------------------------------------
       MOBILE-FIRST CONVERSION ENGINE & EXACT NEXO CARD EMBED STYLES
       -------------------------------------------------------------------------- */
    :root {
      --brand-color: #4F46E5;
      --navy-main: #0A1128;
      --navy-dark: #050814;
      --bg-light: #F8FAFC;
      --font-poppins: 'Poppins', -apple-system, sans-serif;

      /* Embedded Card Tokens */
      --bg-base: #F1F5F9;
      --card-bg: #FFFFFF;
      --text-title: #0F172A;
      --text-sub: var(--brand-color);
      --text-body: #64748B;
      --tile-bg: rgba(241, 245, 249, 0.75);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      touch-action: manipulation;
    }

    html {
      scroll-behavior: smooth;
      text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }

    html, body {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden !important;
      position: relative;
      font-family: var(--font-poppins);
      background-color: #FFFFFF;
      color: #0F172A;
    }

    body {
      padding-bottom: 84px;
    }

    .btn-cta-primary {
      background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
      color: #FFFFFF;
      font-weight: 800;
      font-size: 16px;
      padding: 16px 24px;
      border-radius: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.4);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      width: 100%;
      text-align: center;
      border: none;
      cursor: pointer;
    }

    .btn-cta-primary:active {
      transform: scale(0.98);
    }

    .btn-sticky-bar {
      background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
      color: #FFFFFF;
      font-weight: 800;
      font-size: 14px;
      padding: 12px 18px;
      border-radius: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-decoration: none;
      box-shadow: 0 4px 15px rgba(79, 70, 229, 0.35);
      width: 100%;
    }

    /* Smartphone Frame Wrapper */
    .mockup-container {
      width: 100%;
      max-width: 350px;
      height: 610px;
      background: #000000;
      border-radius: 40px;
      padding: 10px;
      box-shadow: 0 25px 50px -12px rgba(10, 17, 40, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.15);
      margin: 0 auto;
    }

    .mockup-screen {
      width: 100%;
      height: 100%;
      background: var(--bg-base);
      border-radius: 32px;
      overflow-y: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .mockup-screen::-webkit-scrollbar {
      display: none;
    }

    /* Embedded Exact Card Design Styles */
    .card-wrapper {
      width: 100%;
      background-color: var(--card-bg);
      border-radius: 32px;
      overflow: hidden;
      position: relative;
      padding-bottom: 16px;
      z-index: 1;
      font-family: 'Inter', -apple-system, sans-serif;
    }

    .wave-header {
      position: relative;
      width: 100%;
      height: 110px;
      overflow: hidden;
    }

    .wave-header svg {
      height: 100%;
      width: 100%;
      display: block;
    }

    .theme-toggle-node {
      position: absolute;
      top: 10px;
      right: 12px;
      background: rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(8px);
      padding: 3px 10px;
      border-radius: 20px;
      color: #FFFFFF;
      font-size: 10px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 3px;
      z-index: 10;
    }

    .profile-avatar-area {
      text-align: center;
      margin-top: -50px;
      position: relative;
      z-index: 2;
    }

    .avatar-frame {
      position: relative;
      width: 96px;
      height: 96px;
      margin: 0 auto;
      border-radius: 50%;
      background: #FFFFFF;
      padding: 3px;
      box-shadow: 0 6px 16px rgba(0,0,0,0.12);
    }

    .avatar-img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      object-position: top center;
      display: block;
    }

    .verified-badge {
      position: absolute;
      bottom: 0px;
      right: 0px;
      width: 22px;
      height: 22px;
      z-index: 5;
    }

    .profile-title {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-title);
      margin: 8px 0 2px 0;
      letter-spacing: -0.3px;
    }

    .profile-role {
      color: var(--brand-color);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 2px;
    }

    .profile-company {
      color: var(--text-body);
      font-size: 12px;
      font-weight: 500;
    }

    .action-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 0 12px;
      margin-top: 14px;
    }

    .action-tile {
      text-decoration: none;
      background: var(--tile-bg);
      border-radius: 14px;
      width: 62px;
      height: 60px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .action-tile svg {
      width: 18px;
      height: 18px;
      margin-bottom: 4px;
      display: block;
    }

    .action-tile span {
      font-size: 9px;
      font-weight: 700;
      color: var(--brand-color);
      line-height: 1.1;
      text-align: center;
    }

    .cta-container {
      padding: 0 12px;
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .btn-save-contact {
      background-color: var(--brand-color);
      color: #FFFFFF !important;
      height: 40px;
      border-radius: 14px;
      font-size: 12px;
      font-weight: 700;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border: none;
      width: 100%;
    }

    .btn-wallet-action {
      background-color: #0F172A;
      color: #FFFFFF !important;
      height: 40px;
      border-radius: 14px;
      font-size: 12px;
      font-weight: 700;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      border: none;
    }

    .section-box {
      margin: 12px 12px 0 12px;
      background: var(--tile-bg);
      border-radius: 16px;
      padding: 12px;
    }

    .section-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-title);
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .map-inner-btn {
      text-decoration: none;
      background: rgba(255, 255, 255, 0.7);
      height: 38px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 700;
      color: var(--text-title) !important;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      margin-top: 8px;
    }

    .brand-footer {
      text-align: center;
      margin: 14px 0 0 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .brand-footer .line-1 {
      font-size: 10px;
      font-weight: 500;
      color: #94A3B8;
    }

    .brand-footer .line-1 .brand-letter {
      color: var(--brand-color);
      font-weight: 800;
    }

    .brand-footer .line-1 .brand-name {
      color: var(--text-title);
      font-weight: 700;
    }

    .brand-footer .line-2 {
      font-size: 8px;
      font-weight: 500;
      color: #64748B;
    }

    .brand-footer .line-2 .brand-domain {
      color: var(--brand-color);
      font-weight: 700;
    }

    /* FAQ Accordion */
    .faq-item {
      border: 1px solid #E2E8F0;
      border-radius: 16px;
      overflow: hidden;
      background: #FFFFFF;
      transition: border-color 0.2s ease;
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s cubic-bezier(0, 1, 0, 1), padding 0.3s ease;
    }

    .faq-item.open .faq-answer {
      max-height: 300px;
      padding-bottom: 16px;
    }

    .faq-item.open .faq-icon {
      transform: rotate(180deg);
    }
  </style>
</head>
<body class="bg-white text-slate-900 antialiased">

  <!-- =========================================================================
       1. SIMPLE LANDING HEADER (NO DISTRACTIONS)
       ========================================================================= -->
  <header class="w-full py-3.5 px-4 bg-white border-b border-slate-100 sticky top-0 z-40">
