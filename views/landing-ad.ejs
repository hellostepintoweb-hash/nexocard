      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-6">
          Your paper visiting card has limits.
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-8">
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/80">
            <div class="text-2xl mb-1">🗑️</div>
            <div class="text-xs font-semibold text-slate-700">Gets Lost</div>
          </div>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/80">
            <div class="text-2xl mb-1">💦</div>
            <div class="text-xs font-semibold text-slate-700">Gets Damaged</div>
          </div>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/80">
