<%- include('../layouts/header') %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  body { background: #f8fafc; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
  .success-card {
    background: #ffffff;
    border-radius: 28px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.05);
  }
  .icon-circle {
    width: 80px;
    height: 80px;
    background: #dcfce7;
    color: #16a34a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    margin: 0 auto 1.5rem auto;
  }
</style>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <div class="success-card p-4 p-md-5 text-center">
        <div class="icon-circle">
          <i class="fa-solid fa-circle-check"></i>
        </div>

        <h3 class="fw-bold text-dark mb-2">Payment Successful!</h3>
        <p class="text-secondary small mb-4">Your NEXO Digital Business Card is published and active.</p>

        <% if (paymentDetails) { %>
          <div class="bg-light p-3 rounded-4 border text-start small mb-4">
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Invoice:</span>
              <span class="fw-bold text-dark"><%= paymentDetails.invoiceNumber %></span>
            </div>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Plan:</span>
              <span class="fw-bold text-dark"><%= paymentDetails.plan %></span>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-muted">Amount Paid:</span>
              <span class="fw-bold text-success">₹<%= paymentDetails.amount %></span>
            </div>
          </div>
        <% } %>

        <a href="/dashboard" class="btn btn-primary w-100 py-3 rounded-4 fw-bold shadow-sm text-decoration-none">
          Go To Dashboard &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>