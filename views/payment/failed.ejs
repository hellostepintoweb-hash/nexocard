<%- include('../layouts/header') %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  body { background: #f8fafc; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
  .failed-card {
    background: #ffffff;
    border-radius: 28px;
    border: 1px solid #fee2e2;
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.05);
  }
  .icon-circle {
    width: 80px;
    height: 80px;
    background: #fee2e2;
    color: #dc2626;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    margin: 0 auto 1.5rem auto;
  }
</style>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <div class="failed-card p-4 p-md-5 text-center">
        <div class="icon-circle">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <h3 class="fw-bold text-dark mb-2">Payment Unsuccessful</h3>
        <p class="text-secondary small mb-4">Your transaction was canceled or declined. Your profile form is safe in your session.</p>

        <div class="d-flex flex-column gap-2">
          <a href="/payment/review" class="btn btn-primary py-3 rounded-4 fw-bold text-decoration-none">
            <i class="fa-solid fa-rotate-right me-1"></i> Retry Payment
          </a>
          <a href="/dashboard" class="btn btn-light py-2 rounded-4 fw-semibold text-secondary text-decoration-none border">
            Return to Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>