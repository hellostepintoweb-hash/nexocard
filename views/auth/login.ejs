<%- include('../layouts/header') %>

<!-- Core Font & Icon Dependencies -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  :root {
    --nexo-bg: #f6f8fa;
    --nexo-card-bg: #ffffff;
    --nexo-primary: #4f46e5;
    --nexo-primary-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    --nexo-border: #e2e8f0;
    --nexo-text-dark: #0f172a;
    --nexo-text-muted: #64748b;
    --nexo-radius: 22px;
    --nexo-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
    --nexo-shadow-hover: 0 20px 35px -12px rgba(79, 70, 229, 0.12);
  }

  body {
    background-color: var(--nexo-bg);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--nexo-text-dark);
    -webkit-font-smoothing: antialiased;
  }

  .nexo-auth-container {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.5rem;
  }

  .nexo-auth-card {
    background: var(--nexo-card-bg);
    border: 1px solid var(--nexo-border);
    border-radius: var(--nexo-radius);
    box-shadow: var(--nexo-shadow);
    width: 100%;
    max-width: 440px;
    padding: 2.5rem 2rem;
    transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Form Control Styles */
  .nexo-form-control {
    background-color: #f8fafc;
    border: 1px solid var(--nexo-border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    color: var(--nexo-text-dark);
    transition: all 200ms ease;
  }
  .nexo-form-control:focus {
    background-color: #ffffff;
    border-color: var(--nexo-primary);
    box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
    outline: none;
  }

  .nexo-input-group-text {
    background-color: #f8fafc;
    border: 1px solid var(--nexo-border);
    border-right: none;
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    color: var(--nexo-text-muted);
  }

  .nexo-input-group .form-control {
    border-left: none;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }

  /* Buttons */
  .btn-nexo-gradient {
    background: var(--nexo-primary-gradient);
    color: #ffffff !important;
    border: none;
    border-radius: 14px;
    padding: 12px 28px;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
    transition: all 250ms ease;
  }
  .btn-nexo-gradient:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(79, 70, 229, 0.35);
  }

  .btn-nexo-google {
    background: #ffffff;
    border: 1px solid var(--nexo-border);
    color: var(--nexo-text-dark) !important;
    border-radius: 14px;
    padding: 11px 24px;
    font-weight: 600;
    transition: all 200ms ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
  }
  .btn-nexo-google:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    transform: translateY(-1px);
    color: var(--nexo-text-dark) !important;
  }

  /* Divider */
  .auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    color: var(--nexo-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 1.5rem 0;
  }
  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--nexo-border);
  }
  .auth-divider:not(:empty)::before {
    margin-right: .75em;
  }
  .auth-divider:not(:empty)::after {
    margin-left: .75em;
  }

  /* Mobile Tweaks */
  @media (max-width: 576px) {
    .nexo-auth-container {
      padding: 1.5rem 1rem;
    }
    .nexo-auth-card {
      padding: 2rem 1.25rem;
    }
  }
</style>

<div class="nexo-auth-container">
  <div class="nexo-auth-card">
    
    <!-- BRANDING LOGO -->
    <div class="text-center mb-4">
            <h4 class="fw-bold text-dark mb-1">Welcome Back</h4>
      <p class="text-secondary small mb-0">Access your Nexo digital identity</p>
    </div>

    <!-- ERROR ALERT -->
    <% if (error) { %>
      <div class="alert alert-danger border-0 rounded-3 p-3 small d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #fef2f2; color: #991b1b;">
        <i class="fa-solid fa-circle-exclamation flex-shrink-0"></i>
        <div><%= error %></div>
      </div>
    <% } %>

    <!-- FORM -->
    <form action="/auth/login" method="POST" class="d-flex flex-column gap-3">
      <div>
        <label class="form-label fw-semibold text-dark small mb-1">Email Address</label>
        <div class="input-group nexo-input-group">
          <span class="input-group-text nexo-input-group-text"><i class="fa-regular fa-envelope"></i></span>
          <input type="email" name="email" required class="form-control nexo-form-control shadow-none" placeholder="name@example.com">
        </div>
      </div>

<div>
  <div class="d-flex justify-content-between align-items-center mb-1">
    <label class="form-label fw-semibold text-dark small mb-0">Password</label>
    <a href="/auth/reset-password" class="text-primary small text-decoration-none fw-semibold">Forgot Password?</a>
  </div>
  <div class="input-group nexo-input-group">
    <span class="input-group-text nexo-input-group-text"><i class="fa-solid fa-lock"></i></span>
    <input type="password" name="password" required class="form-control nexo-form-control shadow-none" placeholder="••••••••">
  </div>
</div>

      <button type="submit" class="btn btn-nexo-gradient w-100 mt-2">
        Sign In <i class="fa-solid fa-arrow-right ms-1 style-tiny"></i>
      </button>
    </form>

    <div class="auth-divider">Or continue with</div>

    <!-- GOOGLE LOGIN -->
    <a href="/auth/google" class="btn-nexo-google w-100">
      <i class="fab fa-google text-danger"></i> Continue with Google
    </a>

    <!-- REGISTER LINK -->
    <p class="mt-4 text-center text-secondary small mb-0">
      Don't have an account? <a href="/auth/register" class="text-primary fw-bold text-decoration-none">Register</a>
    </p>

  </div>
</div>
