<%- include('../layouts/header') %>

<div class="nexo-auth-container">
  <div class="nexo-auth-card">
    
    <div class="text-center mb-4">
      <h4 class="fw-bold text-dark mb-1">Reset Password</h4>
      <p class="text-secondary small mb-0">Enter your email address and new password</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger border-0 rounded-3 p-3 small d-flex align-items-center gap-2 mb-4" style="background-color: #fef2f2; color: #991b1b;">
        <i class="fa-solid fa-circle-exclamation flex-shrink-0"></i>
        <div><%= error %></div>
      </div>
    <% } %>

    <form action="/auth/reset-password" method="POST" class="d-flex flex-column gap-3">
      <div>
        <label class="form-label fw-semibold text-dark small mb-1">Email Address</label>
        <div class="input-group nexo-input-group">
          <span class="input-group-text nexo-input-group-text"><i class="fa-regular fa-envelope"></i></span>
          <input type="email" name="email" required class="form-control nexo-form-control shadow-none" placeholder="name@example.com">
        </div>
      </div>

      <div>
        <label class="form-label fw-semibold text-dark small mb-1">New Password</label>
        <div class="input-group nexo-input-group">
          <span class="input-group-text nexo-input-group-text"><i class="fa-solid fa-lock"></i></span>
          <input type="password" name="password" required class="form-control nexo-form-control shadow-none" placeholder="••••••••">
        </div>
      </div>

      <div>
        <label class="form-label fw-semibold text-dark small mb-1">Confirm New Password</label>
        <div class="input-group nexo-input-group">
          <span class="input-group-text nexo-input-group-text"><i class="fa-solid fa-lock"></i></span>
          <input type="password" name="confirmPassword" required class="form-control nexo-form-control shadow-none" placeholder="••••••••">
        </div>
      </div>

      <button type="submit" class="btn btn-nexo-gradient w-100 mt-2">
        Update Password <i class="fa-solid fa-arrow-right ms-1 style-tiny"></i>
      </button>
    </form>

    <p class="mt-4 text-center text-secondary small mb-0">
      Remembered your password? <a href="/auth/login" class="text-primary fw-bold text-decoration-none">Sign In</a>
    </p>

  </div>
</div>
