<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nexo Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container d-flex flex-column align-items-center justify-content-center min-vh-100 text-center py-5">
  <div class="card border-0 shadow-lg p-5 rounded-4" style="max-width: 480px; width: 100%;">
    <div class="mb-4">
      <span class="badge bg-danger-subtle text-danger fs-6 px-3 py-2 rounded-pill fw-semibold">Card Unavailable</span>
    </div>
    
    <div class="display-1 fw-bold text-secondary mb-3">
      <i class="fas fa-id-card-clip"></i>
    </div>

    <h3 class="fw-bold text-dark mb-2">Nexo Card Not Available</h3>
    
    <p class="text-secondary small mb-4">
      This digital card has been permanently deleted or removed by its owner and is no longer accessible.
    </p>

    <div class="d-grid gap-2">
      <a href="/" class="btn btn-primary py-2.5 rounded-3 fw-semibold" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none;">
        Go to Home
      </a>
    </div>
  </div>
</div>
</body>
</html>

