<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
  let activeCardIdToDelete = null;
  let confirmationModalInstance = null;
  let activeShareCardData = null;
  let shareModalInstance = null;

  let targetRemoveForm = null;
  let removeWalletModalInstance = null;

  // Utility to convert image resources to File objects for native sharing
  async function fetchFileFromUrl(url, filename, mimeType) {
    const res = await fetch(url);
    const blob = await res.blob();
    return new File([blob], filename, { type: mimeType });
  }

  document.addEventListener("DOMContentLoaded", () => {
    updateSegmentedPillPosition();
    window.addEventListener('resize', updateSegmentedPillPosition);

    // Dashboard Search Filter
    const searchInput = document.getElementById('dashboardCardSearch');
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        document.querySelectorAll('#dashboardCardsContainer .card-item-wrapper').forEach(card => {
          const name = card.dataset.name || '';
          card.style.display = name.includes(query) ? '' : 'none';
        });
      });
    }

    // Dashboard Sort Filter
    const sortSelect = document.getElementById('dashboardCardSort');
    if (sortSelect) {
      sortSelect.addEventListener('change', function() {
        const val = this.value;
        const container = document.getElementById('dashboardCardsContainer');
        const cards = Array.from(container.querySelectorAll('.card-item-wrapper'));

        cards.sort((a, b) => {
          if (val === 'alphabetical') {
            return (a.dataset.name || '').localeCompare(b.dataset.name || '');
          } else if (val === 'most_viewed') {
            return parseInt(b.dataset.views || '0', 10) - parseInt(a.dataset.views || '0', 10);
          } else if (val === 'oldest') {
            return parseInt(a.dataset.time || '0', 10) - parseInt(b.dataset.time || '0', 10);
          } else { 
            return parseInt(b.dataset.time || '0', 10) - parseInt(a.dataset.time || '0', 10);
          }
        });

        cards.forEach(card => container.appendChild(card));
      });
    }

    // Wallet Live Search
    const walletSearchInput = document.getElementById('walletCardSearch');
    if (walletSearchInput) {
      walletSearchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        let visibleCount = 0;
        
        document.querySelectorAll('#walletCardsContainer .wallet-card-item').forEach(card => {
          const name = card.dataset.name || '';
          const title = card.dataset.title || '';
          const company = card.dataset.company || '';
          const address = card.dataset.address || '';
          const about = card.dataset.about || '';

          const matches = name.includes(query) || 
                          title.includes(query) || 
                          company.includes(query) || 
                          address.includes(query) || 
                          about.includes(query);

          card.style.display = matches ? '' : 'none';
          if (matches) visibleCount++;
        });

        const emptyState = document.getElementById('walletEmptyState');
        if (emptyState) {
          if (visibleCount === 0) emptyState.classList.remove('d-none');
          else emptyState.classList.add('d-none');
        }
      });
    }

    // Delete Card Modal
    document.querySelectorAll(".deleteBtn").forEach(btn => {
      btn.addEventListener("click", function () {
        activeCardIdToDelete = this.dataset.id;
        const modalEl = document.getElementById('deleteConfirmModal');
        if (modalEl) {
          confirmationModalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
          confirmationModalInstance.show();
        }
      });
    });

    const confirmBtn = document.getElementById('confirmDeleteBtn');
    if (confirmBtn) {
      confirmBtn.addEventListener('click', async () => {
        if (activeCardIdToDelete) await executeDeleteRequest(activeCardIdToDelete);
      });
    }

    // Wallet Remove Modal
    const removeWalletModalEl = document.getElementById('removeWalletModal');
    if (removeWalletModalEl) {
      removeWalletModalInstance = bootstrap.Modal.getInstance(removeWalletModalEl) || new bootstrap.Modal(removeWalletModalEl);
    }

    document.querySelectorAll(".remove-wallet-btn").forEach(btn => {
      btn.addEventListener("click", function (e) {
        e.preventDefault();
        targetRemoveForm = this.closest('form');
        const cardName = this.dataset.cardName || 'this card';

        const nameSpan = document.getElementById('removeCardNameText');
        if (nameSpan) nameSpan.textContent = cardName;

        if (removeWalletModalInstance) {
          removeWalletModalInstance.show();
        }
      });
    });

    const confirmRemoveBtn = document.getElementById('confirmRemoveWalletBtn');
    if (confirmRemoveBtn) {
      confirmRemoveBtn.addEventListener('click', () => {
        if (targetRemoveForm) {
          if (removeWalletModalInstance) removeWalletModalInstance.hide();
          targetRemoveForm.submit();
        }
      });
    }

    // Share Modal
    const shareModalEl = document.getElementById('shareCardModal');
    if (shareModalEl) shareModalInstance = bootstrap.Modal.getInstance(shareModalEl) || new bootstrap.Modal(shareModalEl);

    document.querySelectorAll(".btn-share-card").forEach(btn => {
      btn.addEventListener("click", function () {
        try {
          activeShareCardData = JSON.parse(this.dataset.card);
          if (shareModalInstance) shareModalInstance.show();
        } catch (e) {
          console.error("Invalid card dataset", e);
        }
      });
    });

    // 1. View Live Card Option
    const btnShareViewLive = document.getElementById('shareViewLiveBtn');
    if (btnShareViewLive) {
      btnShareViewLive.addEventListener('click', () => {
        if (!activeShareCardData) return;
        if (shareModalInstance) shareModalInstance.hide();
        const slug = activeShareCardData.handle || activeShareCardData.slug || '';
        window.open(`/c/${slug}`, '_blank');
      });
    }

    // 2. Share as Profile Link (Native Device Share)
    const btnShareAsLink = document.getElementById('shareAsLinkBtn');
    if (btnShareAsLink) {
      btnShareAsLink.addEventListener('click', async () => {
        if (!activeShareCardData) return;
        if (shareModalInstance) shareModalInstance.hide();

        const slug = activeShareCardData.handle || activeShareCardData.slug || '';
        const shareUrl = `${window.location.origin}/c/${slug}`;
        const cardName = activeShareCardData.fullName || activeShareCardData.name || 'Digital Card';

        const shareData = {
          title: `${cardName}'s Nexo Card`,
          text: `Check out ${cardName}'s digital business card:`,
          url: shareUrl
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (err) {
            if (err.name !== 'AbortError') console.error('Error sharing link:', err);
          }
        } else {
          try {
            await navigator.clipboard.writeText(shareUrl);
            showNotificationAlert('Profile link copied to clipboard!', 'success');
          } catch(err) {
            showNotificationAlert('Failed to copy link', 'danger');
          }
        }
      });
    }

    // 3. Share as QR Code (Native Device Share)
    const btnShareAsQR = document.getElementById('shareAsQRBtn');
    if (btnShareAsQR) {
      btnShareAsQR.addEventListener('click', async () => {
        if (!activeShareCardData) return;
        if (shareModalInstance) shareModalInstance.hide();

        const slug = activeShareCardData.handle || activeShareCardData.slug || '';
        const qrUrl = activeShareCardData.qrCodeDataUrl || `/c/${slug}/qr`;

        try {
          const file = await fetchFileFromUrl(qrUrl, `${slug}-qr.png`, 'image/png');

          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({
              files: [file],
              title: 'QR Code',
              text: `Scan to view digital card:`
            });
          } else {
            window.open(qrUrl, '_blank');
          }
        } catch (err) {
          if (err.name !== 'AbortError') {
            console.error('Error sharing QR Code:', err);
            window.open(qrUrl, '_blank');
          }
        }
      });
    }

    // 4. Share as PDF (Native Device Share)
    const btnShareAsPDF = document.getElementById('shareAsPDFBtn');
    if (btnShareAsPDF) {
      btnShareAsPDF.addEventListener('click', async () => {
        if (!activeShareCardData) return;
        if (shareModalInstance) shareModalInstance.hide();

        try {
          showNotificationAlert('Preparing card PDF...', 'info');
          const doc = await buildPDFDocument(activeShareCardData);
          const slug = activeShareCardData.handle || activeShareCardData.slug || 'nexo';
          const pdfBlob = doc.output('blob');
          const pdfFile = new File([pdfBlob], `${slug}_nexocard.pdf`, { type: 'application/pdf' });

          if (navigator.canShare && navigator.canShare({ files: [pdfFile] })) {
            await navigator.share({
              files: [pdfFile],
              title: `${slug} Business Card PDF`,
              text: `Here is the digital business card PDF:`
            });
          } else {
            doc.save(`${slug}_nexocard.pdf`);
            showNotificationAlert('PDF generated with active links!', 'success');
          }
        } catch (err) {
          if (err.name !== 'AbortError') {
            console.error('Error sharing PDF:', err);
            showNotificationAlert('Unable to share PDF profile.', 'danger');
          }
        }
      });
    }

    document.querySelectorAll(".btn-download-pdf").forEach(btn => {
      btn.addEventListener("click", async function () {
        try {
          const cardData = JSON.parse(this.dataset.card);
          await exportDirectVectorPDF(cardData);
        } catch(e) {
          console.error("PDF download parse error", e);
        }
      });
    });
  });

  function updateSegmentedPillPosition() {
    const activeBtn = document.querySelector('.segmented-nav-btn.active');
    const pill = document.getElementById('segmentedPill');
    if (activeBtn && pill) {
      pill.style.width = `${activeBtn.offsetWidth}px`;
      pill.style.left = `${activeBtn.offsetLeft}px`;
    }
  }

  function switchWorkspaceTab(tabName) {
    const btnDashboard = document.getElementById('btnTabDashboard');
    const btnWallet = document.getElementById('btnTabWallet');
    const paneDashboard = document.getElementById('tabPaneDashboard');
    const paneWallet = document.getElementById('tabPaneWallet');

    if (!btnDashboard || !btnWallet || !paneDashboard || !paneWallet) return;

    if (tabName === 'dashboard') {
      btnDashboard.classList.add('active');
      btnWallet.classList.remove('active');

      paneWallet.classList.remove('active-pane');
      setTimeout(() => {
        paneWallet.classList.add('d-none');
        paneDashboard.classList.remove('d-none');
        setTimeout(() => paneDashboard.classList.add('active-pane'), 10);
      }, 250);

    } else if (tabName === 'wallet') {
      btnWallet.classList.add('active');
      btnDashboard.classList.remove('active');

      paneDashboard.classList.remove('active-pane');
      setTimeout(() => {
        paneDashboard.classList.add('d-none');
        paneWallet.classList.remove('d-none');
        setTimeout(() => paneWallet.classList.add('active-pane'), 10);
      }, 250);
    }

    updateSegmentedPillPosition();
  }

  function toggleDashboardLayout(type) {
    const container = document.getElementById('dashboardCardsContainer');
    const btnList = document.getElementById('btnViewList');
    const btnGrid = document.getElementById('btnViewGrid');

    if (!container || !btnList || !btnGrid) return;

    if (type === 'grid') {
      container.classList.add('as-grid');
      btnGrid.classList.add('btn-white', 'shadow-sm', 'active');
      btnGrid.classList.remove('text-muted');
      btnList.classList.remove('btn-white', 'shadow-sm', 'active');
      btnList.classList.add('text-muted');
    } else {
      container.classList.remove('as-grid');
      btnList.classList.add('btn-white', 'shadow-sm', 'active');
      btnList.classList.remove('text-muted');
      btnGrid.classList.remove('btn-white', 'shadow-sm', 'active');
      btnGrid.classList.add('text-muted');
    }
  }

  async function executeDeleteRequest(cardId) {
    try {
      if (confirmationModalInstance) confirmationModalInstance.hide();
      
      const response = await fetch(`/card/delete/${cardId}`, { 
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      });

      if (!response.ok) throw new Error(`Server responded with status ${response.status}`);

      const result = await response.json();

      if (result.success) {
        const cardElement = document.getElementById(`card-instance-${cardId}`);
        if (cardElement) {
          cardElement.style.transition = 'all 0.3s ease';
          cardElement.style.opacity = '0';
          setTimeout(() => cardElement.remove(), 300);
        }
        showNotificationAlert('Card deleted successfully!', 'success');
      } else {
        showNotificationAlert(result.error || 'Delete failed', 'danger');
      }
    } catch (err) {
      console.error('Delete Request Failed:', err);
      showNotificationAlert('Error connecting to server.', 'danger');
    }
  }

  // PDF GENERATION ENGINE
  function getJsPDFClass() {
    if (window.jspdf && window.jspdf.jsPDF) return window.jspdf.jsPDF;
    if (typeof window.jsPDF === 'function') return window.jsPDF;
    if (typeof window.jspdf === 'function') return window.jspdf;
    return null;
  }

  function loadScriptFallback(urls) {
    return new Promise((resolve, reject) => {
      if (getJsPDFClass()) return resolve(getJsPDFClass());

      let index = 0;
      function tryNext() {
        if (index >= urls.length) return reject(new Error('All CDNs failed to load'));
        const script = document.createElement('script');
        script.src = urls[index++];
        script.onload = () => {
          const PDFClass = getJsPDFClass();
          if (PDFClass) resolve(PDFClass);
          else tryNext();
        };
        script.onerror = tryNext;
        document.head.appendChild(script);
      }
      tryNext();
    });
  }

  async function ensureJsPDF() {
    if (getJsPDFClass()) return getJsPDFClass();
    return await loadScriptFallback([
      'https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js',
      'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js',
      'https://unpkg.com/jspdf@2.5.1/dist/jspdf.umd.min.js'
    ]);
  }

  async function ensureHtml2Canvas() {
    if (window.html2canvas) return window.html2canvas;
    return new Promise((resolve, reject) => {
      const urls = [
        'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js',
        'https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js'
      ];
      let idx = 0;
      function tryLoad() {
        if (idx >= urls.length) return reject(new Error('html2canvas load failed'));
        const script = document.createElement('script');
        script.src = urls[idx++];
        script.onload = () => resolve(window.html2canvas);
        script.onerror = tryLoad;
        document.head.appendChild(script);
      }
      tryLoad();
    });
  }

  function fetchAndConvertToBase64(url) {
    return new Promise((resolve) => {
      if (!url || typeof url !== 'string') return resolve(null);
      const img = new Image();
      img.crossOrigin = 'Anonymous';
      img.onload = () => {
        try {
          const canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth || img.width;
          canvas.height = img.naturalHeight || img.height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0);
          resolve({
            dataUrl: canvas.toDataURL('image/png'),
            width: canvas.width,
            height: canvas.height
          });
        } catch (e) {
          resolve(null);
        }
      };
      img.onerror = () => resolve(null);
      img.src = url;
    });
  }

  function svgToDataUrl(svgString) {
    return 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgString)));
  }

  function getSocialUrlFromCard(card, platformName) {
    if (Array.isArray(card.socialLinks)) {
      const item = card.socialLinks.find(s => s.platform && s.platform.toLowerCase() === platformName);
      if (item && item.url) return item.url;
    }
    return (card.socialLinks && card.socialLinks[platformName]) || card[platformName] || '';
  }

  async function buildPDFDocument(card) {
    const PDFClass = await ensureJsPDF();
    const html2canvasLib = await ensureHtml2Canvas();

    const bgImageObj = await fetchAndConvertToBase64('/background.png');

    // Ensure production domain or fallback origin is used
    const hostOrigin = (typeof process !== 'undefined' && process.env && process.env.BASE_URL)
      ? process.env.BASE_URL
      : window.location.origin;

    const cardSlug = card.handle || card.slug || '';
    const liveCardUrl = `${hostOrigin}/c/${cardSlug}`;
    const vcardUrl = `${hostOrigin}/c/${cardSlug}/vcard`;
    
    const cardName = card.fullName || card.name || 'User Profile';
    const cardTitle = card.title || card.designation || '';
    const userSummary = card.about || card.summary;
    const isDarkMode = (card.theme && card.theme.mode === 'dark');

    const brandColor = (card.theme && card.theme.primaryColor) ? card.theme.primaryColor : '#4F46E5';
    
    const cardBg = 'transparent';
    const textTitle = isDarkMode ? '#F8FAFC' : '#0F172A';
    const textBody = isDarkMode ? '#94A3B8' : '#64748B';
    const tileBg = isDarkMode ? 'rgba(15, 23, 42, 0.4)' : 'rgba(248, 250, 252, 0.5)';

    const instaVal = getSocialUrlFromCard(card, 'instagram');
    const fbVal = getSocialUrlFromCard(card, 'facebook');
    const linkedinVal = getSocialUrlFromCard(card, 'linkedin');
    const ytVal = getSocialUrlFromCard(card, 'youtube');
    const twitterVal = getSocialUrlFromCard(card, 'twitter');
    const telegramVal = getSocialUrlFromCard(card, 'telegram');

    const instaUrl = instaVal ? (instaVal.startsWith('http') ? instaVal : 'https://instagram.com/' + instaVal.replace('@', '')) : '';
    const fbUrl = fbVal ? (fbVal.startsWith('http') ? fbVal : 'https://facebook.com/' + fbVal) : '';
    const linkedinUrl = linkedinVal ? (linkedinVal.startsWith('http') ? linkedinVal : 'https://linkedin.com/in/' + linkedinVal) : '';
    const ytUrl = ytVal ? (ytVal.startsWith('http') ? ytVal : 'https://youtube.com/' + (ytVal.startsWith('@') ? ytVal : '@' + ytVal)) : '';
    const twitterUrl = twitterVal ? (twitterVal.startsWith('http') ? twitterVal : 'https://twitter.com/' + twitterVal.replace('@', '')) : '';
    const telegramUrl = telegramVal ? (telegramVal.startsWith('http') ? telegramVal : 'https://t.me/' + telegramVal.replace('@', '')) : '';

    const cleanPhone = card.phone ? card.phone.replace(/[^0-9+]/g, '') : '';
    const cleanWhatsapp = (card.whatsapp || card.phone) ? (card.whatsapp || card.phone).replace(/[^0-9]/g, '') : '';
    const formattedWebsite = card.website ? (card.website.startsWith('http') ? card.website : 'https://' + card.website) : '';
    const mapUrl = (card.googleMapUrl && card.googleMapUrl.trim()) ? card.googleMapUrl : (card.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(card.address)}` : '');

    let safePhotoUrl = null;
    if (card.profilePhoto || card.avatarUrl) {
      const imgRes = await fetchAndConvertToBase64(card.profilePhoto || card.avatarUrl);
      if (imgRes) safePhotoUrl = imgRes.dataUrl;
    }

    if (card.gallery && card.gallery.length > 0) {
      for (let item of card.gallery) {
        if (item.url) {
          const imgRes = await fetchAndConvertToBase64(item.url);
          if (imgRes) item.base64 = imgRes.dataUrl;
        }
      }
    }

    if (card.services && card.services.length > 0) {
      for (let s of card.services) {
        if (s.image) {
          const imgRes = await fetchAndConvertToBase64(s.image);
          if (imgRes) s.base64 = imgRes.dataUrl;
        }
      }
    }

    const initials = cardName ? cardName.split(' ').map(n => n[0]).join('').toUpperCase().substring(0,2) : 'NX';
    const fallbackAvatarSvg = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"><rect width="100" height="100" fill="${encodeURIComponent(brandColor)}"/><text x="50%" y="55%" font-family="Inter, sans-serif" font-size="34" font-weight="800" fill="%23FFFFFF" text-anchor="middle" dominant-baseline="middle">${initials}</text></svg>`;

    const avatarSource = safePhotoUrl || fallbackAvatarSvg;

    const callIcon = svgToDataUrl(`<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="${brandColor}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`);
    const waIcon = svgToDataUrl(`<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="${brandColor}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`);
