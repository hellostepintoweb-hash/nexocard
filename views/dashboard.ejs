    }));

    const containerRect = cardContainer.getBoundingClientRect();
    const linkElements = cardContainer.querySelectorAll('[data-link-target]');
    const hotSpots = [];

    linkElements.forEach(el => {
      const targetUrl = el.getAttribute('data-link-target');
      if (targetUrl) {
        const rect = el.getBoundingClientRect();
        hotSpots.push({
          url: targetUrl,
          x: rect.left - containerRect.left,
          y: rect.top - containerRect.top,
          w: rect.width,
          h: rect.height
        });
      }
    });

    const canvas = await html2canvasLib(cardContainer, {
      scale: 3,
      useCORS: true,
      allowTaint: false,
      logging: false,
      backgroundColor: null,
      scrollX: 0,
      scrollY: 0,
      windowWidth: document.documentElement.offsetWidth,
      windowHeight: document.documentElement.offsetHeight,
      onclone: (clonedDoc) => {
        const clonedContainer = clonedDoc.querySelector('div[style*="-99999"]');
        if (clonedContainer) {
          clonedContainer.style.position = 'relative';
          clonedContainer.style.top = '0';
          clonedContainer.style.left = '0';
          clonedContainer.style.zIndex = '1';
          clonedContainer.style.opacity = '1';
        }
      }
    });

    document.body.removeChild(cardContainer);

    const imgData = canvas.toDataURL('image/png', 1.0);
    const pdfWidth = 85;
    const pdfHeight = (canvas.height * pdfWidth) / canvas.width;

    const doc = new PDFClass({
      orientation: 'portrait',
      unit: 'mm',
      format: [pdfWidth, pdfHeight]
    });

    if (bgImageObj && bgImageObj.dataUrl && bgImageObj.width && bgImageObj.height) {
      const imgRatio = bgImageObj.width / bgImageObj.height;
      const pdfRatio = pdfWidth / pdfHeight;
      let drawW, drawH, offsetX, offsetY;

      if (imgRatio > pdfRatio) {
        drawH = pdfHeight;
        drawW = pdfHeight * imgRatio;
        offsetX = (pdfWidth - drawW) / 2;
        offsetY = 0;
      } else {
        drawW = pdfWidth;
        drawH = pdfWidth / imgRatio;
        offsetX = 0;
        offsetY = (pdfHeight - drawH) / 2;
      }

      doc.addImage(bgImageObj.dataUrl, 'PNG', offsetX, offsetY, drawW, drawH, undefined, 'FAST');
    }

    doc.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight, undefined, 'FAST');

    const scaleToPDF = pdfWidth / containerRect.width;

    hotSpots.forEach(spot => {
      doc.link(
        spot.x * scaleToPDF,
        spot.y * scaleToPDF,
        spot.w * scaleToPDF,
        spot.h * scaleToPDF,
        { url: spot.url }
      );
    });

    return doc;
  }

  async function exportDirectVectorPDF(card) {
    try {
      showNotificationAlert('Preparing high-res profile card...', 'info');
      const doc = await buildPDFDocument(card);
      const slug = card.handle || card.slug || 'nexo';
      doc.save(`${slug}-pro-card.pdf`);
      showNotificationAlert('PDF generated with active links!', 'success');
    } catch (err) {
      console.error('PDF Generation Error:', err);
      showNotificationAlert('Unable to render high-res PDF profile.', 'danger');
    }
  }

  function showNotificationAlert(message, type) {
    const container = document.getElementById('alertContainer');
    if (!container) return;
    const wrapper = document.createElement('div');
    wrapper.innerHTML = `
      <div class="alert alert-${type} alert-dismissible fade show shadow-sm border-0 rounded-3 p-3" role="alert">
        <span>${message}</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>`;
    container.appendChild(wrapper);
    setTimeout(() => wrapper.remove(), 3500);
  }
</script>

