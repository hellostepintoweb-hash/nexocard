  <!-- JAVASCRIPT -->
  <script>
  // Failsafe Preloader Removal Logic
  const dismissPreloader = () => {
    const preloader = document.getElementById('preloader');
    if (!preloader) return;
    preloader.style.opacity = '0';
    setTimeout(() => { preloader.style.display = 'none'; }, 250);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', dismissPreloader);
  } else {
    dismissPreloader();
  }
  
  setTimeout(dismissPreloader, 1000);

  // PWA Service Worker & Install Logic
  let deferredPrompt;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    
    // Toggle single install app button
    const installBtn = document.getElementById('pwa-install-btn');
    if (installBtn) installBtn.style.display = 'inline-flex';
  });

  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW fail:', err));
    });
  }

  // Interactive Dynamic Preview Cards
  const profiles = [
    {
      name: "Yazhini",
      role: "FOUNDER",
      company: "Yazhini Printers",
      avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=200",
      about: "E seva Center and All Xerox Printout Services available here.",
      address: "8/31-C, Main Road, Elachipalayam,Tiruchengodu Tk, Namakkal Dt - 637202",
      color: "#556B2F"
    },
    {
      name: "Dr. Rajesh Kumar",
      role: "CARDIOLOGIST",
      company: "City Heart Care Clinic",
      avatar: "https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&q=80&w=200",
      about: "Specialized in cardiovascular wellness, consultations, and heart care.",
      address: "Suite 402, Apex Medical Hub, M.G. Road, Bengaluru",
      color: "#2563EB"
    },
    {
      name: "Ananya Sharma",
      role: "SENIOR ADVOCATE",
      company: "Legal Solutions Chambers",
      avatar: "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&q=80&w=200",
      about: "Corporate litigation, property disputes, and intellectual property attorney.",
      address: "High Court Complex Block B, New Delhi",
      color: "#059669"
    },
    {
      name: "Vikram Mehta",
      role: "PRINCIPAL ARCHITECT",
      company: "Urban Form Studios",
      avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=200",
      about: "Sustainable residential design, commercial interiors, and landscaping.",
      address: "12, Creative Arts District, Cyber City, Gurugram",
      color: "#EA580C"
    },
    {
      name: "Siddharth Verma",
      role: "LEAD ARCHITECT",
      company: "TechScale Solutions",
      avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=200",
      about: "Building scalable cloud microservices and enterprise SaaS platforms.",
      address: "IT Park Phase II, HSR Layout, Bengaluru",
      color: "#DC2626"
    }
  ];

  let currentProfileIndex = 0;
  const cardContainer = document.getElementById('cardContainer');

  function updatePreviewCard(index) {
    const data = profiles[index];
    if(!cardContainer) return;

    cardContainer.style.opacity = '0';
    setTimeout(() => {
      document.getElementById('previewName').innerText = data.name;
      document.getElementById('previewRole').innerText = data.role;
      document.getElementById('previewCompany').innerText = data.company;
      document.getElementById('previewAvatar').src = data.avatar;
      document.getElementById('previewAbout').innerText = data.about;
      document.getElementById('previewAddress').innerText = data.address;
      applyThemeColor(data.color);
      cardContainer.style.opacity = '1';
    }, 150);
  }

  let autoRotate = setInterval(() => {
    currentProfileIndex = (currentProfileIndex + 1) % profiles.length;
    updatePreviewCard(currentProfileIndex);
    document.querySelectorAll('.chip').forEach((chip, idx) => {
      chip.classList.toggle('active', idx === currentProfileIndex);
    });
  }, 4000);

  document.querySelectorAll('.chip').forEach(chip => {
    chip.addEventListener('click', function() {
      clearInterval(autoRotate);
      document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      this.classList.add('active');
      const idx = parseInt(this.getAttribute('data-index')) % profiles.length;
      updatePreviewCard(idx);
    });
  });

  function applyThemeColor(hex) {
    document.documentElement.style.setProperty('--brand-primary', hex);
    document.querySelectorAll('.color-dot').forEach(dot => {
      dot.classList.toggle('active', dot.getAttribute('data-color') === hex);
    });
  }

  document.querySelectorAll('.color-dot').forEach(dot => {
    dot.addEventListener('click', function() {
      applyThemeColor(this.getAttribute('data-color'));
    });
  });
  </script>

