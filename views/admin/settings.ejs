<%- include('../layouts/header') %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h2 class="fw-bold text-dark mb-0">System & Payment Settings</h2>
          <p class="text-muted small">Update global pricing, offer text, and operational controls.</p>
        </div>
        <span class="badge bg-danger px-3 py-2 rounded-pill">Admin Privileged Area</span>
      </div>

      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <form action="/admin/settings" method="POST">
          
          <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-tags me-2"></i> Plan & Pricing Configuration</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Plan Name</label>
              <input type="text" name="planName" class="form-control rounded-3" value="<%= settings.planName %>" required>
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">Price (INR)</label>
              <input type="number" name="price" class="form-control rounded-3" value="<%= settings.price %>" required min="0">
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">Currency Code</label>
              <input type="text" name="currency" class="form-control rounded-3" value="<%= settings.currency %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Payment Type Badge</label>
              <input type="text" name="paymentType" class="form-control rounded-3" value="<%= settings.paymentType %>">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Offer Text Banner</label>
              <input type="text" name="offerText" class="form-control rounded-3" value="<%= settings.offerText %>">
            </div>
          </div>

          <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-sliders me-2"></i> Toggles & Operations</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <div class="form-check form-switch p-3 border rounded-3 bg-light">
                <input class="form-check-input" type="checkbox" name="offerEnabled" id="offerEnabled" <%= settings.offerEnabled ? 'checked' : '' %>>
                <label class="form-check-label fw-semibold small ms-2" for="offerEnabled">Show Offer Banner</label>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-check form-switch p-3 border rounded-3 bg-light">
                <input class="form-check-input" type="checkbox" name="paymentEnabled" id="paymentEnabled" <%= settings.paymentEnabled ? 'checked' : '' %>>
                <label class="form-check-label fw-semibold small ms-2" for="paymentEnabled">Enable Gateway Payments</label>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-check form-switch p-3 border rounded-3 bg-light">
                <input class="form-check-input" type="checkbox" name="maintenanceMode" id="maintenanceMode" <%= settings.maintenanceMode ? 'checked' : '' %>>
                <label class="form-check-label fw-semibold text-danger small ms-2" for="maintenanceMode">Maintenance Mode</label>
              </div>
            </div>
          </div>

          <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-building me-2"></i> Company & Contact Information</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Company Name</label>
              <input type="text" name="companyName" class="form-control rounded-3" value="<%= settings.companyName %>">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Support Email</label>
              <input type="email" name="supportEmail" class="form-control rounded-3" value="<%= settings.supportEmail %>">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Support Phone</label>
              <input type="text" name="supportPhone" class="form-control rounded-3" value="<%= settings.supportPhone %>">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">WhatsApp Business Number</label>
              <input type="text" name="whatsappNumber" class="form-control rounded-3" value="<%= settings.whatsappNumber %>">
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">Company Address</label>
              <input type="text" name="companyAddress" class="form-control rounded-3" value="<%= settings.companyAddress %>">
            </div>
          </div>

          <button type="submit" class="btn btn-primary py-2.5 px-4 rounded-3 fw-bold">
            <i class="fa-solid fa-floppy-disk me-1"></i> Save Settings Instantly
          </button>
        </form>
      </div>

    </div>
  </div>
</div>

<%- include('../layouts/footer') %>